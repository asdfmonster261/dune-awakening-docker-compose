# Copy to .env (or let dune-setup/setup.sh generate it).
# Required values; setup.sh prompts for each and writes a real .env.

# --- User-provided ---

# Friendly world name shown in the in-game server browser (1-50 chars).
WORLD_NAME=My Arrakis

# FLS region used by matchmaking. One of: Asia, Europe, North America, Oceania, South America.
WORLD_REGION=North America

# Self-hosted JWT acquired from your Dune account page (the long ey... string).
FLS_TOKEN=

# FLS API key (UUID format) issued alongside the JWT.
FLS_API_KEY=00000000-0000-0000-0000-000000000000

# Publicly reachable IP players use to connect (NOT 127.0.0.1).
HOST_IP=192.0.2.1

# Browser display name (Bgd.ServerDisplayName CVar on each game-server).
BROWSER_DISPLAY_NAME=My Arrakis, My Dune

# --- Auto-generated by setup.sh ---

# Per-host unique battlegroup ID; format: sh-{FLS_HostId_lowercase}-{6 random lowercase}.
WORLD_UNIQUE_NAME=

# Datacenter ID surfaced in FLS heartbeats; cosmetic. Format: dune-{region_underscored}.
HOST_DATACENTER_ID=

# Postgres superuser password (32-char alnum).
POSTGRES_SUPER_PASS=

# Postgres `dune` user password (32-char alnum).
POSTGRES_DUNE_PASS=

# Shared secret for the RabbitMQ HTTP token auth (64 bytes base64).
RMQ_HTTP_TOKEN_AUTH_SECRET=
